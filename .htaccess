# PHP Einstellungen. Nur mit mod_php moeglich, bei PHP-FPM/CGI wuerde php_value einen 500-Fehler ausloesen.
# Dort stattdessen .user.ini oder php.ini verwenden.
<IfModule mod_php.c>
	php_value memory_limit 5000M
	php_value max_input_vars 1000000
	php_value max_execution_time 60
	php_value post_max_size 400M
	php_value upload_max_filesize 400M
</IfModule>

Options +FollowSymLinks -Indexes

RewriteEngine on


#von www zur nicht www umleiten.
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

#SSL ON! (nicht fuer localhost)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]


#START Zugriff auf Public Dateien ====================
#z.B. domain.cc/public/[plugin-name]/tpl/test.js
RewriteCond %{REQUEST_URI} \.(txt|pdf|doc|js|css|html|otf|eot|svg|ttf|woff|woff2)$
RewriteRule ^public/([^/]+)/(.*)$							system/$1/public/$2 [QSA,END]
#END Zugriff auf Public Dateien ======================

#FILE START ===============
# 1. file/ab12345_12x12.jpg  =>  data_c/fremeo~core/file/ab12345_12x12.jpg
#    Existiert die Datei, wird sie von Apache direkt ausgeliefert (siehe Regel "data_c/" weiter unten).
RewriteRule ^file/([A-Za-z0-9_-]+)_([0-9]+)x([0-9]+)\.(jpg|jpeg|png|gif|webp|avif)$	data_c/fremeo~core/file/$1_$2x$3.$4 [L]

# 2. Existiert die Datei NICHT, wird sie dynamisch erzeugt
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^data_c/fremeo~core/file/([A-Za-z0-9-]+)_([0-9]+)x([0-9]+)\.(jpg|jpeg|png|gif|webp|avif)$	index.php?R[Page]=get_file&R[ModuleId]=fremeo/core&R[id]=$1&R[x]=$2&R[y]=$3&R[extension]=$4 [L]
#FILE ENDE ================


#Seo URL
# setup-Ordner direkt ausliefern und PHP-Ausfuehrung erlauben
RewriteRule ^setup/ - [L]

# file/ und data_c/ nicht als SEO-URL behandeln
RewriteRule ^(file/|data_c/) - [L]

# Alles andere geht an index.php. Bewusst ohne !-f, damit keine Ordner (system/, data/) direkt erreichbar sind.
RewriteRule ^(.*)$			index.php?D[SEO_URL]=$1 [QSA,L]


#Performance Optimierung ==============
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(js|css|gif|png|jpe?g|webp|avif|pdf|ico)$">
		Header set Cache-Control "max-age=604800, public"
	</FilesMatch>
</IfModule>
