{
    "name": "fremeo/loader",
    "version": "1.0.4",
    "description": "A phpApp loader for PHP projects: installation, package management, and configuration all in one.",
    "license": "MIT",
    "type": "project",
    "keywords": ["fremeo"],
    "require": {
        "php": "^8.0",
		"fremeo/core": ">=0.0.7 <1.0",
        "fremeo/gallery": "*",
        "fremeo/blog": "*",
        "fremeo/frontend": ">=0.0.1 <1.0",
        "fremeo/page": "*",
        "fremeo/shop": "*",
        "phploader/cdata": "*",
        "phploader/smarty4life": "*",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "*",
        "intervention/image": "*",
        "matthiasmullie/minify": "^1.3.76",
        "wikimedia/css-sanitizer": "^6.0"
        
    },
    "autoload": {
        "psr-4": {
            "fremeo\\frontend\\": "system/vendor/fremeo/frontend/system/core/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php index.php migration"
        ],
        "post-update-cmd": [
            "@php index.php migration"
        ],
        "post-package-uninstall": [
			"@php index.php uninstall"
        ]
    },
    "config": {
        "vendor-dir": "system/vendor"
    },
	"prefer-stable": true
}
