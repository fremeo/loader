{
    "name": "fremeo/loader",
    "description": "A phpApp loader for PHP projects: installation, package management, and configuration all in one.",
    "license": "MIT",
    "type": "project",
    "keywords": ["fremeo"],
    "require": {
        "php": "^8.0",
		"fremeo/core": ">=0.0.4 <1.0",
        "fremeo/gallery": "*",
        "fremeo/blog": "*",
        "fremeo/frontend": "*",
        "fremeo/page": "*",
        "fremeo/shop": "*",
        "phploader/cdata": "*",
        "phploader/smarty4life": "*",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "*",
        "intervention/image": "*"
        
    },
    "scripts": {
        "post-install-cmd": [
            "@php index.php migration"
        ],
        "post-update-cmd": [
            "@php index.php migration"
        ],
        "post-package-uninstall": [
			"@php index.php uninstall"
        ]
    },
    "config": {
        "vendor-dir": "system/vendor"
    },
	"prefer-stable": true
}
